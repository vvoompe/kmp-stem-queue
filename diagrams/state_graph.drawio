<mxfile host="app.diagrams.net" version="24.7.17"><diagram id="state-graph" name="Граф станів"><mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="q0" value="q₀&#xa;0 клієнтів" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="100" height="70" as="geometry"/></mxCell><mxCell id="q1" value="q₁&#xa;1 клієнт" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="210" y="240" width="100" height="70" as="geometry"/></mxCell><mxCell id="qc" value="qC&#xa;C клієнтів" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="390" y="240" width="100" height="70" as="geometry"/></mxCell><mxCell id="qcp1" value="q(C+1)&#xa;1 у черзі" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="580" y="240" width="110" height="70" as="geometry"/></mxCell><mxCell id="qk" value="qK, K=C+m&#xa;система повна" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="800" y="240" width="130" height="70" as="geometry"/></mxCell><mxCell id="a01" value="λ" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="q0" target="q1"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="220"/></Array></mxGeometry></mxCell><mxCell id="s10" value="μ" style="endArrow=block;html=1;rounded=0;" edge="1" parent="1" source="q1" target="q0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175" y="330"/></Array></mxGeometry></mxCell><mxCell id="a1c" value="λ" style="endArrow=block